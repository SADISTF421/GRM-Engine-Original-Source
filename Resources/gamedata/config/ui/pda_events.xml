<?xml version='1.0' encoding="UTF-8"?>
<window>
    <!-- EVENTS INFO BACKGROUND -->
	<left_frame_window x="76" y="62" width="448" height="475" a="80">
		<texture>ui\ui_pda_frame_sub</texture>

		<list x="15" y="84" width="430" height="380" right_ident="10"/>

		<task_descr_view x="0" y="0" width="409" height="475">
			<scroll_view  x="8" y="45" width="396" height="416" right_ident="10">
				<objective_item x="0" y="0" width="386" height="10">
					<image x="170" y="0" width="90" height="90" stretch="1"/>
							
					<text_cont x="5" y="90" width="386" height="10">
						<text font="letterica18" r="255" g="255" b="255"/>
					</text_cont>
							
				</objective_item>
			</scroll_view>
		</task_descr_view>
	</left_frame_window>

    <!-- EVENTS INFO BACKGROUND HEADER -->
    <left_frame_line x="8" y="17" width="434" height="21">
        <title x="10" y="1" width="435" height="18">
            <text font="letterica16" r="255" g="255" b="255"></text>
        </title>
        <texture>ui\ui_string_03</texture>
    </left_frame_line>

    <!-- EVENTS CURRENT ARTICLE HEADER -->
	<article_header_static x="22" y="48" width="350" height="22">
		<text font="letterica25" r="225" g="225" b="250"></text>
	</article_header_static>

    <!-- EVENTS LIST BACKGROUND -->
    <right_frame_window x="539" y="62" width="298" height="475" a="80">
        <texture>ui\ui_pda_frame_sub</texture>

		<filter_tab x="35" y="60" width="100" height="80">
			<auto_static x="0" y="0" width="100" height="30">
				<text font="letterica18" r="225" g="225" b="250">Jobs</text>
			</auto_static>
			<button x="10" y="20" width="100" height="12">
				<text align="l"  x="0" y="0" font="letterica16" r="255" g="255" b="255">Current</text>
				<text_color>
					<t r="255" g="255" b="255"/> <d r="255" g="255" b="255"/> <e r="255" g="255" b="255"/> <h r="255" g="255" b="255"/>
				</text_color>			
			</button>								
			<button x="10" y="40" width="100" height="12">
				<text align="l"  x="0" y="0" font="letterica16" r="255" g="255" b="255">Accomplished</text>
				<text_color>
					<t r="255" g="255" b="255"/> <d r="255" g="255" b="255"/> <e r="255" g="255" b="255"/> <h r="255" g="255" b="255"/>
				</text_color>			
			</button>								
			<button x="10" y="60" width="100" height="12">
				<text align="l"  x="0" y="0" font="letterica16" r="255" g="255" b="255">Failed</text>
				<text_color>
					<t r="255" g="255" b="255"/> <d r="255" g="255" b="255"/> <e r="255" g="255" b="255"/> <h r="255" g="255" b="255"/>
				</text_color>			
			</button>										
		</filter_tab>
    </right_frame_window>

	<!-- FONT FOR TREE ROOT ITEMS -->
	<tree_root_font font="letterica18" r="225" g="225" b="250">Encyclopedia</tree_root_font>
    <!-- FONT FOR TREE ITEMS -->
	<tree_item_font font="letterica16" r="255" g="255" b="255">Encyclopedia</tree_item_font>
	<unread_color r="0" g="255" b="0"/>

    <!-- EVENTS LIST HEADER -->
    <right_frame_line x="8" y="16" width="284" height="27">
        <title x="10" y="2" width="545" height="440">
            <text font="letterica25" r="225" g="225" b="250">Notebook</text>
        </title>
        <texture>ui\ui_string_02</texture>
    </right_frame_line>

    <!-- EVENTS INDEX LIST -->
    <idx_list x="35" y="60" width="258" height="395" item_height="20">
        <font font="letterica16" r="255" g="255" b="255"></font>
    </idx_list>

    <!--  ANIMATED STATIC -->
    <a_static x="250" y="-3" width="32" height="32"
            frames          = "16"
            duration        = "1000"
            columns         = "8"
            frame_width     = "32"
            frame_height    = "32"
            cyclic          = "1"
            autoplay        = "1"
    >
        <texture>ui\ui_pda_anims_01</texture>
    </a_static>

  	<!-- AUTOSTATICS FOR LEFT FRAME WINDOW -->
	
	<!-- LEFT LADDER -->
	<left_auto_static x="8" y="41" width="4" height="430">
		<texture>ui\ui_pda_vertical_line_l_l</texture>
	</left_auto_static>
	<!-- RIGHT LADDER -->
	<left_auto_static x="416" y="82" width="4" height="388">
		<texture>ui\ui_pda_vertical_line_l_r</texture>
	</left_auto_static>
	<!-- UPPER HORISONTAL LINE -->
	<left_auto_static x="14" y="78" width="405" height="2" stretch="1">
		<texture>ui\ui_pda_horizontal_line</texture>
	</left_auto_static>

  	<!-- AUTOSTATICS FOR RIGHT FRAME WINDOW -->

	<!-- LEFT LADDER -->
	<right_auto_static x="8" y="52" width="4" height="420">
		<texture>ui\ui_pda_vertical_line_r_l</texture>
	</right_auto_static>
	<!-- RIGHT LADDER -->
	<right_auto_static x="269" y="52" width="4" height="420">
		<texture>ui\ui_pda_vertical_line_r_r</texture>
	</right_auto_static>
   	<!-- UPPER EVENTS HORISONTAL LINE -->
	<right_auto_static x="8" y="48" width="262" height="2" stretch="1">
		<texture>ui\ui_pda_horizontal_line</texture>
	</right_auto_static>

	<!-- BACK BUTTON -->
	<back_button x="450" y="513" width="41" height="22">
		<text x="0" y="0" font="letterica18" r="255" g="255" b="255">Back</text>
	</back_button>
</window>

