}


function send_tip(actor, news_id, timeout, sender, showtime, sender_id)
	if news_id == nil then return false end
	printf("try to send tips for [%s]", tostring(sender_id))
	if sender_id ~= nil then
		local sim = alife()
		if sim ~= nil then
			local npc = sim:story_object(sender_id)
			if npc ~= nil then
				if npc.online then
					--в онлайне проверяем на раненность
					if xr_wounded.is_heavy_wounded_by_id(npc.id) then
						printf("[PDA]Cannot send tips [%s], sender is heavy wounded", tostring(news_id))
						return false
					end
				end
				-- в других случаях только на смерть
				if npc:alive() == 1 then
					printf("[PDA]Cannot send tips [%s], sender is dead", tostring(news_id))
					return false
				end
			end
		end
	end

	if timeout == nil then timeout = 0 end
	if showtime == nil then showtime = 5000 end

	--' Играем дефолтный звук
	pda_tips:play(db.actor, timeout, sound_object.s2d)
	if news[news_id] ~= nil then
		--' Играем звук забитый
		news[news_id]:play(db.actor, timeout+1, sound_object.s2d)

		--' Необходимо поставить время показа по длине сцены
		local length = news[news_id]:length()
		if length > showtime then
			showtime = length
		end
	end
	local x = 50
	local y = 100
	if sender ~= nil and tips_icons[sender] ~= nil then
		x = tips_icons[sender][1]
		y = tips_icons[sender][2]
	end
	local news_text = "%c[255,160,160,160]"..game.translate_string("st_tip").."\\n".."%c[default]"..game.translate_string(news_id)
	actor:give_game_news(news_text, "ui\\ui_icons_task", Frect():set(x,y,50,50), timeout*1000, showtime)
	return true
end
function send_tip_nosound(actor, news_id, timeout, sender)
	if news_id == nil then return end

	timeout = 0

	--' Играем дефолтный звук
	pda_tips:play(db.actor, timeout, sound_object.s2d)
	local news_sound = news[news_id]

	return news_sound
end

function send_help(actor)
	if db.actor == nil then return false end
	--' Играем дефолтный звук
	pda_sos:play(db.actor, 0, sound_object.s2d)
	db.actor:give_game_news("Срочно нужна аптечка, помираю!!!", "ui\\ui_icons_task", Frect():set(100,100,50,50), 0, 0)
end

function send_task(actor, type)
	if db.actor == nil then return false end
	--' Играем дефолтный звук
	pda_task:play(db.actor, 0, sound_object.s2d)
	if type == "new" then
		db.actor:give_game_news("Получено новое задание.", "ui\\ui_icons_task", Frect():set(150,100,50,50), 0, 0)
		if db.actor:is_talking() then
			db.actor:give_talk_message("Получено новое задание.", "ui\\ui_icons_task", Frect():set(150,100,50,50),"iconed_answer_item")
		end
	elseif type == "update" then
		db.actor:give_game_news("Задание обновлено.", "ui\\ui_icons_task", Frect():set(250,100,50,50), 0, 0)
		if db.actor:is_talking() then
			db.actor:give_talk_message("Задание обновлено.", "ui\\ui_icons_task", Frect():set(250,100,50,50),"iconed_answer_item")
		end
	elseif type == "complete" then
		db.actor:give_game_news("Задание выполнено.", "ui\\ui_icons_task", Frect():set(350,100,50,50), 0, 0)
		if db.actor:is_talking() then
			db.actor:give_talk_message("Задание выполнено.", "ui\\ui_icons_task", Frect():set(350,100,50,50),"iconed_answer_item")
		end
	elseif type == "fail" then
		db.actor:give_game_news("Задание провалено.", "ui\\ui_icons_task", Frect():set(300,100,50,50), 0, 0)
		if db.actor:is_talking() then
			db.actor:give_talk_message("Задание провалено.", "ui\\ui_icons_task", Frect():set(300,100,50,50),"iconed_answer_item")
		end
	end	
end
function send_encyclopedy(type)
	pda_task:play(db.actor, 0, sound_object.s2d)	
	if type == "encyclopedy" then
		db.actor:give_game_news("Новая статья в энциклопедии.", "ui\\ui_icons_task", Frect():set(350,150,50,50), 0, 0)		
	else
		db.actor:give_game_news("Новая запись в дневнике.", "ui\\ui_icons_task", Frect():set(350,150,50,50), 0, 0)	
	end	
end
function send_treasure(name)
	pda_news:play(db.actor, 0, sound_object.s2d)
	
	local news_text = "%c[255,160,160,160]"..game.translate_string("st_found_new_treasure").."\\n".."%c[default]"..game.translate_string(name)
	
	db.actor:give_game_news(news_text, "ui\\ui_icons_task", Frect():set(350,0,50,50), 0, 3000)
end

function get_inv_name(section)
	return system_ini():r_string(section,"inv_name")
end

function relocate_item(actor, type, item)
	if db.actor == nil then return false end
	--' Играем дефолтный звук
	if type == "in" then
		local news_text = "%c[default]"..game.translate_string("general_in_item").." ".."%c[default]"..game.translate_string(get_inv_name(item))		
		if db.actor:is_talking() then
			db.actor:give_talk_message(news_text, "ui\\ui_icons_task", Frect():set(400,100,50,50),"iconed_answer_item")
		else
			db.actor:give_game_news(news_text, "ui\\ui_icons_task", Frect():set(400,100,50,50), 0, 3000)
		end		
	elseif type == "out" then
		local news_text = "%c[default]"..game.translate_string("general_out_item").." ".."%c[default]"..game.translate_string(get_inv_name(item))		
		if db.actor:is_talking() then
			db.actor:give_talk_message(news_text, "ui\\ui_icons_task", Frect():set(400,100,50,50),"iconed_answer_item")
		else
			db.actor:give_game_news(news_text, "ui\\ui_icons_task", Frect():set(400,100,50,50), 0, 3000)
		end		
	end
	
end
function relocate_money(actor, type, amount)
	if db.actor == nil then return false end


	--' Играем дефолтный звук
	if type == "in" then
		local news_text = "%c[default]"..game.translate_string("general_in_money").." ".."%c[default]"..game.translate_string(tostring(amount))
		
		if db.actor:is_talking() then
			db.actor:give_talk_message(news_text, "ui\\ui_icons_task", Frect():set(450,50,50,50), "iconed_answer_item")
		else
			db.actor:give_game_news(news_text, "ui\\ui_icons_task", Frect():set(450,50,50,50), 0, 3000)
		end		
	elseif type == "out" then
		local news_text = "%c[default]"..game.translate_string("general_out_money").." ".."%c[default]"..game.translate_string(tostring(amount))
		
		if db.actor:is_talking() then
			db.actor:give_talk_message(news_text, "ui\\ui_icons_task", Frect():set(450,50,50,50), "iconed_answer_item")
		else
			db.actor:give_game_news(news_text, "ui\\ui_icons_task", Frect():set(450,50,50,50), 0, 3000)
		end		
	end
	
end